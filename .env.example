# Copy to .env (gitignored) — docker compose reads it automatically.
NODE_ENV=development
BASE_URL=http://localhost:4100
JWT_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
DATA_ENCRYPTION_KEY=change-me-32-byte-random-string
CORS_ORIGINS=*

# Account approval (FR-ADM-02)
OWNER_AUTO_APPROVE=false
TENANT_AUTO_APPROVE=true

# Billing
PLATFORM_FEE_PERCENT=2
INVOICE_ADVANCE_DAYS=7
RENT_REMINDER_INTERVAL_DAYS=3
LEASE_EXPIRY_REMINDER_DAYS=30
COMPLAINT_ESCALATION_DAYS=7

# SMS gateway (Ethio Telecom / Geez SMS). SMS_MOCK=true logs messages instead.
SMS_MOCK=true
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=

# Telebirr (Ethio Telecom). TELEBIRR_MOCK=true needs no credentials.
TELEBIRR_MOCK=true
TELEBIRR_API_BASE_URL=
TELEBIRR_WEB_BASE_URL=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCH_CODE=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
